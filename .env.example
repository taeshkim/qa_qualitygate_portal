# ============================================================
# Quality Gate Portal — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values

# ----- Django Core -----
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.dev

# ----- Database (PostgreSQL) -----
DB_HOST=db
DB_PORT=5432
DB_NAME=quality_gate_portal
DB_USER=qgp_user
DB_PASSWORD=qgp_password

# ----- Redis (Cache + Celery Broker) -----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ----- Encryption -----
ENCRYPTION_MASTER_KEY=base64-encoded-aes-256-key

# ----- Jenkins -----
JENKINS_DEFAULT_URL=https://jenkins.example.com
JENKINS_DEFAULT_USER=qgp-service
JENKINS_DEFAULT_API_TOKEN=your-jenkins-api-token
JENKINS_WEBHOOK_SECRET=your-webhook-hmac-secret

# ----- Slack 알림 (활성) -----
# QualityGate 파이프라인 이벤트 (Run 시작/종료, 단계 전이, Test Suite, Argo CD 실패) 를
# Slack 으로 알림. 토큰은 여기서만 관리하고, 채널/이벤트별 토글은 어드민 화면 (/accounts/notifications/) 에서.
# Bot Token Scopes 는 chat:write 필요. 봇이 알림 채널에 초대돼 있어야 함.
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_DEFAULT_CHANNEL=#qg-alerts
# Run 상세 페이지 링크를 Slack 메시지에 포함하려면 이 값을 운영 도메인으로 채운다.
QGP_BASE_URL=https://qualitygate.jkintra.net

# ----- Google Sheets 동기화 (담당자 마스터, 활성) -----
# /accounts/api-owners/ 의 담당자 마스터를 Google Sheets 와 동기화한다 (CSV 업로드 대체).
# 필요 API: Google Drive API (이미 활성). Drive files.export(text/csv) 로 첫 번째 탭(gid=0)을 CSV 로 받아온다.
# 그리고 대상 시트를 "호출 주체(principal)"에 "뷰어"로 공유해야 한다.
#
# [방식 A — Workload Identity Federation(WIF)/ADC 파일] (현재 운영 방식)
# 자격증명 파일 경로만 지정하면 type(service_account/authorized_user/external_account)을
# 자동 판별한다. WIF(external_account)는 임퍼소네이트하는 서비스 계정 이메일
# (service_account_impersonation_url 에 박힌 ...@....iam.gserviceaccount.com)에 시트를 공유.
GOOGLE_CREDENTIALS_FILE=/home/taeshkim/qa_qualitygate_portal/secrets/qg-owners-wif.json
#
# [방식 B — 서비스 계정 JSON 키 직접 임베드]
# Google Console > IAM & Admin > Service Accounts 에서 계정 생성 → JSON 키 다운로드 →
# base64 로 인코딩 (macOS/Linux: base64 -i service-account.json | tr -d '\n') 하여 아래에 넣고,
# 대상 시트를 그 서비스 계정 이메일(...@....iam.gserviceaccount.com)에 "뷰어"로 공유.
# (GOOGLE_CREDENTIALS_FILE 가 설정돼 있으면 그쪽이 우선한다.)
# GOOGLE_SA_JSON_B64=base64-encoded-service-account-json
# (대안) 위 대신 원본 JSON 한 줄, 또는 SA 키 파일 경로:
# GOOGLE_SA_JSON={"type":"service_account",...}
# GOOGLE_SA_FILE=/home/taeshkim/qa_qualitygate_portal/secrets/qg-owners-sa.json
# 동기화 대상 스프레드시트 ID (URL 의 /d/<ID>/ 부분)
GSHEET_OWNERS_SPREADSHEET_ID=11SO6gucBWw8bsyT5tuBy9WzAf750UkVt0G2SKk8W4bs

# ----- Slack (legacy — 사용 안 함) -----
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_QG_ALERTS_CHANNEL=C09XXXXXX
SLACK_QPE_OPS_CHANNEL=C09XXXXXX

# ----- TAS -----
TAS_BASE_URL=https://tas.example.com
TAS_API_KEY=your-tas-api-key
TAS_WEBHOOK_SECRET=your-tas-webhook-secret

# ----- Portal -----
QGP_BASE_URL=http://localhost:8000
QGP_ADMIN_EMAIL=admin@example.com
